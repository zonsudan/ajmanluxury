<%- include('layout', {
    body: `
<!-- 1. Full-Screen Cinematic Edge-to-Edge Hero Video (Smart NFC Luxury Concept) -->
<section class="hero-video-fullwidth" aria-label="Cinematic Campaign">
    <div class="video-container">
        <video class="bg-cinematic-video" autoplay muted loop playsinline preload="auto">
            <source src="/videos/nfc-smart-luxury-hero.mp4?v=1.0" type="video/mp4">
            <source src="/videos/promo-atmosphere.mp4" type="video/mp4">
        </video>
        <div class="video-gradient-overlay"></div>
    </div>
</section>

<!-- 2. Iconic 3saf Brush Circles Categories (The 5 Perfumes Exclusively) -->
<section class="brush-categories-section" id="categories-section">
    <div class="container">
        <div class="brush-categories-grid">
            <!-- Circle 1: بريزدنت (President) -->
            <a href="#product-president" class="brush-circle-item">
                <div class="brush-ring-wrap">
                    <svg class="brush-svg" viewBox="0 0 200 200">
                        <path class="brush-path" d="M100,10 C150,10 190,50 190,100 C190,150 150,190 100,190 C45,190 10,150 10,100 C10,48 52,10 102,12" />
                    </svg>
                    <div class="circle-inner-photo">
                        <img src="/images/products/president.png" alt="بريزدنت">
                    </div>
                </div>
                <h3 class="brush-cat-title">${lang === 'ar' ? 'بريزدنت' : 'President'}</h3>
            </a>

            <!-- Circle 2: فيرست ليدي (First Lady) -->
            <a href="#product-first-lady" class="brush-circle-item">
                <div class="brush-ring-wrap">
                    <svg class="brush-svg" viewBox="0 0 200 200">
                        <path class="brush-path" d="M105,12 C155,10 192,52 188,102 C188,152 148,188 98,190 C48,188 12,148 10,98 C12,48 50,12 100,10" />
                    </svg>
                    <div class="circle-inner-photo">
                        <img src="/images/products/first-lady.png" alt="فيرست ليدي">
                    </div>
                </div>
                <h3 class="brush-cat-title">${lang === 'ar' ? 'فيرست ليدي' : 'First Lady'}</h3>
            </a>

            <!-- Circle 3: تشيرمان (Chairman) -->
            <a href="#product-chairman" class="brush-circle-item">
                <div class="brush-ring-wrap">
                    <svg class="brush-svg" viewBox="0 0 200 200">
                        <path class="brush-path" d="M98,10 C148,12 188,50 190,100 C188,150 150,192 100,188 C50,190 10,152 12,100 C10,50 48,10 102,12" />
                    </svg>
                    <div class="circle-inner-photo">
                        <img src="/images/products/chairman.png" alt="تشيرمان">
                    </div>
                </div>
                <h3 class="brush-cat-title">${lang === 'ar' ? 'تشيرمان' : 'Chairman'}</h3>
            </a>

            <!-- Circle 4: كاونسل (Council) -->
            <a href="#product-council" class="brush-circle-item">
                <div class="brush-ring-wrap">
                    <svg class="brush-svg" viewBox="0 0 200 200">
                        <path class="brush-path" d="M100,10 C152,10 190,52 188,102 C190,152 152,190 102,190 C52,188 10,148 12,98 C10,48 50,12 102,10" />
                    </svg>
                    <div class="circle-inner-photo">
                        <img src="/images/products/council.png" alt="كاونسل">
                    </div>
                </div>
                <h3 class="brush-cat-title">${lang === 'ar' ? 'كاونسل' : 'Council'}</h3>
            </a>

            <!-- Circle 5: برلمان (Parliament) -->
            <a href="#product-parliament" class="brush-circle-item">
                <div class="brush-ring-wrap">
                    <svg class="brush-svg" viewBox="0 0 200 200">
                        <path class="brush-path" d="M102,12 C154,12 192,54 188,104 C188,154 150,192 100,192 C48,190 10,150 10,100 C10,48 52,10 102,12" />
                    </svg>
                    <div class="circle-inner-photo">
                        <img src="/images/products/parliament.png" alt="برلمان">
                    </div>
                </div>
                <h3 class="brush-cat-title">${lang === 'ar' ? 'برلمان' : 'Parliament'}</h3>
            </a>
        </div>
    </div>
</section>

<!-- 3. Featured 5 Exclusive Scents (3saf Products Grid) -->
<section class="collection-section" id="featured-collection">
    <div class="container">
        <div class="section-title-wrap">
            <span class="section-sub">${lang === 'ar' ? 'عطور النيش الخاصة' : 'Signature Niche Perfumes'}</span>
            <h2 class="section-main-title">${lang === 'ar' ? 'مجموعة عجمان لكجري الحصرية' : 'Exclusive AJMAN LUXURY Collection'}</h2>
            <p class="section-desc">${lang === 'ar' ? 'خمسة إصدارات أيقونية تمثل ذروة الفخامة والأناقة، مع عينة تجربة مجانية وضمان استرجاع كامل.' : 'Five iconic creations crafted to perfection with complimentary tester samples.'}</p>
        </div>

        <div class="products-grid-3saf">
            ${products.map((product) => `
                <article class="product-card-3saf" id="product-${product.id}" data-product-id="${product.id}">
                    <a href="/product/${product.id}?lang=${lang}" class="card-image-link" aria-label="${product.name}">
                        <div class="card-arch-alcove">
                            <span class="card-nfc-tag" title="${lang === 'ar' ? 'مزود بشريحة NFC الذكية للأصالة' : 'NFC Smart Bottle'}">
                                <i class="fa-solid fa-wifi fa-rotate-90"></i> NFC
                            </span>
                            <img src="${product.image}?v=4.0" alt="${product.name}" class="product-image" loading="lazy">
                            <div class="card-bottom-pill">
                                <span class="pill-badge-black">${product.badge || (lang === 'ar' ? 'عرض خاص' : 'Special')}</span>
                            </div>
                        </div>
                    </a>

                    <div class="card-content">
                        <h3 class="product-title">
                            <a href="/product/${product.id}?lang=${lang}">${product.name}</a>
                        </h3>
                        <p class="product-volume">${product.size || '100 مل'}</p>

                        <div class="card-rating">
                            <span class="reviews-count">(${product.reviewsCount || '1,200'})</span>
                            <span class="rating-num">${product.rating || '5.0'}</span>
                            <div class="stars">
                                <i class="fas fa-star"></i>
                            </div>
                        </div>

                        <div class="price-container">
                            ${product.originalPrice ? `<span class="old-price">${product.originalPrice}</span>` : ''}
                            <span class="current-price" data-base-price="${product.price}">${product.price}</span>
                        </div>

                        <div class="card-action-wrap">
                            <button type="button" class="btn-add-to-cart" data-add-to-cart 
                                    data-product-id="${product.id}" 
                                    data-product-name="${product.name}" 
                                    data-product-price="${product.price}" 
                                    data-product-image="${product.image}">
                                <i class="fas fa-bag-shopping"></i>
                                <span>${lang === 'ar' ? 'إضافة' : 'Add to Bag'}</span>
                            </button>
                            <a href="/nfc/${product.id}?lang=${lang}" class="card-nfc-preview-link">
                                <i class="fas fa-mobile-screen"></i>
                                <span>${lang === 'ar' ? 'تجربة زجاجة الـ NFC' : 'NFC Pass'}</span>
                            </a>
                        </div>
                    </div>
                </article>
            `).join('')}
        </div>
    </div>
</section>

<!-- 4. Golden Guarantee Section (3saf Experience) -->
<section class="golden-guarantee-section" id="golden-guarantee">
    <div class="container guarantee-container">
        <div class="guarantee-box">
            <div class="guarantee-badge">
                <i class="fas fa-shield-halved"></i>
            </div>
            <div class="guarantee-text">
                <span class="guarantee-eyebrow">${lang === 'ar' ? 'التسوق الآمن والمضمون' : 'Safe & Guaranteed Shopping'}</span>
                <h2>${lang === 'ar' ? 'الضمان الذهبي للتجربة من عجمان لكجري' : 'The Golden Trial Guarantee by AJMAN LUXURY'}</h2>
                <p>
                    ${lang === 'ar' 
                        ? 'نحن نثق تماماً في جودة وفخامة عطورنا وثباتها؛ لذلك نرفق مع كل زجاجة تطلبها <strong>عينة تجربة مجانية</strong> لنفس العطر. جرب العينة أولاً بكل راحة، وإن لم ينل العطر إعجابك التام، يمكنك إعادة الزجاجة الأصلية مغلقة واسترداد كامل المبلغ فوراً وبكل سهولة.'
                        : 'We take absolute pride in our perfumes. Every order includes a <strong>complimentary tester sample</strong>. If you are not completely enchanted, simply return the unopened full bottle for an immediate 100% refund.'}
                </p>
                <div class="guarantee-points">
                    <div class="point-item"><i class="fas fa-check-circle"></i> <span>${lang === 'ar' ? 'عينة تجربة مجانية مع كل زجاجة' : 'Complimentary tester sample with every order'}</span></div>
                    <div class="point-item"><i class="fas fa-check-circle"></i> <span>${lang === 'ar' ? 'استرجاع مجاني وسريع بدون تعقيد' : 'Hassle-free complimentary returns'}</span></div>
                    <div class="point-item"><i class="fas fa-check-circle"></i> <span>${lang === 'ar' ? 'ضمان ثبات وفوحان يدوم 48 ساعة' : 'Guaranteed 48h projection & longevity'}</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. NFC Smart Fragrance Showcase (Phygital Luxury) -->
<section class="nfc-showcase-section" id="nfc-smart-fragrance">
    <div class="container">
        <div class="nfc-showcase-wrap">
            <div class="nfc-showcase-text">
                <span class="nfc-section-badge"><i class="fa-solid fa-wifi fa-rotate-90"></i> ${lang === 'ar' ? 'الفخامة الذكية المتصلة' : 'Connected Smart Luxury'}</span>
                <h2 class="nfc-main-title">${lang === 'ar' ? 'شريحة NFC مدمجة في غطاء كل عطر' : 'Integrated NFC Chip in Every Bottle'}</h2>
                <p class="nfc-desc">${lang === 'ar' ? 'نقلة ريادية تدمج عراقة العطور الإماراتية بأحدث تقنيات التحقق الذكي. فقط المس غطاء الزجاجة الذهبي بهاتفك لتفتح لك عالماً خاصاً من الامتيازات الفورية والأصالة الموثقة.' : 'A breakthrough merging Emirati perfume mastery with cryptographic smart NFC verification. Simply tap the golden cap with your smartphone to unlock immediate authenticity, personalized gifting, and bespoke privileges.'}</p>
                
                <div class="nfc-features-grid">
                    <div class="nfc-feat-box">
                        <div class="nfc-feat-icon"><i class="fas fa-shield-halved"></i></div>
                        <div>
                            <h4>${lang === 'ar' ? 'توثيق الأصالة الفوري' : 'Instant Authenticity'}</h4>
                            <p>${lang === 'ar' ? 'شهادة رقمية مشفرة تثبت مصدر العطر وتفاصيل الدفعة بدون أدنى احتمال للتقليد.' : 'Cryptographic proof verifying batch number and authenticity.'}</p>
                        </div>
                    </div>
                    <div class="nfc-feat-box">
                        <div class="nfc-feat-icon"><i class="fas fa-gift"></i></div>
                        <div>
                            <h4>${lang === 'ar' ? 'الإهداء الذكي المخصص' : 'Smart Digital Gifting'}</h4>
                            <p>${lang === 'ar' ? 'سجل رسالة إهداء خاصة، وحين يستلم المهدى إليه الزجاجة ويلمسها بهاتفه تنفتح له رسالتك.' : 'Attach a bespoke digital note that displays when the recipient taps the bottle.'}</p>
                        </div>
                    </div>
                    <div class="nfc-feat-box">
                        <div class="nfc-feat-icon"><i class="fas fa-sparkles"></i></div>
                        <div>
                            <h4>${lang === 'ar' ? 'أسرار الهرم العطري' : 'Scent Masterclass'}</h4>
                            <p>${lang === 'ar' ? 'دليل خبير العطور للنوتات النادرة وأفضل أسلوب للرش لثبات يتجاوز 48 ساعة.' : 'Master perfumer guidance on scent notes and optimal pulse application.'}</p>
                        </div>
                    </div>
                    <div class="nfc-feat-box">
                        <div class="nfc-feat-icon"><i class="fas fa-crown"></i></div>
                        <div>
                            <h4>${lang === 'ar' ? 'إعادة طلب بخصم النخبة' : 'VIP 15% One-Tap Reorder'}</h4>
                            <p>${lang === 'ar' ? 'طلب زجاجتك التالية بلمسة واحدة مع خصم حصري دائم 15% لملاك الزجاجة الأصلية.' : 'Reorder with a single tap at an exclusive VIP discount.'}</p>
                        </div>
                    </div>
                </div>

                <div class="nfc-cta-action">
                    <a href="/nfc/president?lang=${lang}" class="btn-nfc-demo">
                        <i class="fas fa-mobile-screen"></i>
                        <span>${lang === 'ar' ? 'جرّب تجربة مسح الـ NFC التفاعلية الآن' : 'Preview Live NFC Experience'}</span>
                    </a>
                </div>
            </div>

            <div class="nfc-showcase-visual">
                <div class="nfc-phone-mockup">
                    <div class="phone-screen-preview">
                        <div class="phone-status-bar">
                            <span>9:41</span>
                            <div class="phone-icons"><i class="fas fa-wifi"></i> <i class="fas fa-battery-full"></i></div>
                        </div>
                        <div class="phone-inner-content">
                            <div class="phone-check-circle"><i class="fas fa-check"></i></div>
                            <h5>${lang === 'ar' ? 'تم التحقق من الأصالة بنجاح' : 'Authenticity Verified'}</h5>
                            <span class="phone-serial">#AJM-9024-PRE</span>
                            <img src="/images/products/president.png?v=4.0" alt="President" class="phone-bottle-thumb">
                            <span class="phone-p-name">PRESIDENT</span>
                            <span class="phone-p-tag">${lang === 'ar' ? 'إكستريت دي بارفان' : 'Extrait de Parfum'}</span>
                        </div>
                    </div>
                    <div class="nfc-wave-emitter">
                        <div class="wave wave-1"></div>
                        <div class="wave wave-2"></div>
                        <div class="wave wave-3"></div>
                        <i class="fa-solid fa-wifi fa-rotate-90 nfc-wave-icon"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
`
}) %>
