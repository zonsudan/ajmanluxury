<%- include('layout', {
    body: `
<section class="product-details-page">
    <div class="container product-details-container">
        <div class="product-details-image-col">
            <div class="card-arch-alcove detail-arch">
                <span class="card-nfc-tag" title="${lang === 'ar' ? 'مزود بشريحة NFC الذكية للأصالة' : 'NFC Smart Bottle'}">
                    <i class="fa-solid fa-wifi fa-rotate-90"></i> NFC
                </span>
                <img src="${product.image}?v=4.0" alt="${product.name}" class="product-detail-photo">
            </div>
            <a href="/nfc/${product.id}?lang=${lang}" class="detail-nfc-live-pill">
                <i class="fas fa-mobile-screen-button"></i>
                <span>${lang === 'ar' ? 'جرّب تجربة مسح الـ NFC التفاعلية للزجاجة' : 'Preview Live Bottle NFC Experience'}</span>
                <i class="fas fa-arrow-left"></i>
            </a>
        </div>
        <div class="product-details-info">
            <div class="detail-breadcrumb">
                <a href="/?lang=${lang}">${lang === 'ar' ? 'الرئيسية' : 'Home'}</a> / 
                <a href="/#featured-collection">${lang === 'ar' ? 'العطور الخاصة' : 'Signature Scents'}</a> / 
                <span>${product.name}</span>
            </div>
            
            <h1 class="detail-title">${product.name}</h1>
            <p class="detail-type">${product.type} — ${product.size}</p>
            
            <div class="detail-rating-row">
                <div class="stars">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                </div>
                <span class="rating-val">5.0</span>
                <span class="reviews-val">(${product.reviewsCount || '1,200'} ${lang === 'ar' ? 'تقييم موثق' : 'verified reviews'})</span>
            </div>

            <div class="detail-price-box">
                <span class="detail-price">${product.price}</span>
                ${product.originalPrice ? `<span class="detail-old-price">${product.originalPrice}</span>` : ''}
                <span class="vat-badge">${lang === 'ar' ? 'شامل الضريبة والشحن مجاني' : 'VAT Incl. & Free Express Shipping'}</span>
            </div>

            <!-- Smart NFC Feature Callout -->
            <div class="detail-smart-nfc-box">
                <div class="nfc-icon-col">
                    <i class="fa-solid fa-wifi fa-rotate-90"></i>
                </div>
                <div class="nfc-box-text">
                    <strong>${lang === 'ar' ? 'الزجاجة الذكية — مزودة بتقنية NFC المدمجة' : 'Smart Bottle — Built-in NFC Authenticity Chip'}</strong>
                    <p>${lang === 'ar' ? 'المس الغطاء بهاتفك في أي وقت للتحقق من الأصالة، تفعيل الإهداء المخصص، وإعادة الطلب السريع بخصم النخبة 15%.' : 'Tap the cap with your smartphone to verify authenticity, view scent secrets, or reorder with VIP 15% discount.'}</p>
                </div>
            </div>

            
            <!-- Purchase Tier Selector: Single Bottle / Custom Trio / Royal 5-in-1 Box -->
            <div class="product-tier-selector-box" id="productTierSelectorBox">
                <div class="tier-box-header">
                    <span class="tier-label-title"><i class="fas fa-layer-group"></i> ${lang === 'ar' ? 'خيارات الشراء والباقات:' : 'Select Purchase Option:'}</span>
                </div>

                <div class="tier-options-list">
                    <!-- Option 1: Single Bottle -->
                    <label class="tier-card-option active" data-tier="single">
                        <input type="radio" name="purchase_tier_option" value="single" checked>
                        <div class="tier-radio-custom"></div>
                        <div class="tier-card-content">
                            <div class="tier-header-line">
                                <span class="tier-name">${lang === 'ar' ? 'زجاجة واحدة (الحبة)' : 'Single Bottle'}</span>
                                <span class="tier-price-val">${product.price}</span>
                            </div>
                            <span class="tier-subtext">${product.name} (100 مل)</span>
                        </div>
                    </label>

                    <!-- Option 2: Custom Trio Selection -->
                    <label class="tier-card-option" data-tier="trio">
                        <input type="radio" name="purchase_tier_option" value="trio">
                        <div class="tier-radio-custom"></div>
                        <div class="tier-card-content">
                            <div class="tier-header-line">
                                <span class="tier-name">${lang === 'ar' ? 'سلكشن 3 عطور فاخرة' : 'Custom Trio Selection'}</span>
                                <span class="tier-badge-save">${lang === 'ar' ? 'وفّر 35%' : 'Save 35%'}</span>
                                <span class="tier-price-val">990 د.إ</span>
                            </div>
                            <span class="tier-subtext">${lang === 'ar' ? 'يشمل هذا العطر + اختر عطرين إضافيين' : 'Includes this scent + 2 more of your choice'}</span>
                        </div>
                    </label>

                    <!-- Option 3: Royal 5-in-1 Box -->
                    <label class="tier-card-option" data-tier="royal5">
                        <input type="radio" name="purchase_tier_option" value="royal5">
                        <div class="tier-radio-custom"></div>
                        <div class="tier-card-content">
                            <div class="tier-header-line">
                                <span class="tier-name">${lang === 'ar' ? 'البوكس الملكي (5 عطور)' : 'The Royal 5-in-1 Box'}</span>
                                <span class="tier-badge-save gold-save">${lang === 'ar' ? 'وفّر 1,000 د.إ' : 'Save 1,000 AED'}</span>
                                <span class="tier-price-val">1,490 د.إ</span>
                            </div>
                            <span class="tier-subtext">${lang === 'ar' ? 'الـ 5 عطور كاملة في صندوق إهداء ملكي فاخر' : 'All 5 full-size 100ml perfumes'}</span>
                        </div>
                    </label>
                </div>

                <!-- Trio 2-scents picker dropdown/grid (shown only when Trio is selected) -->
                <div class="detail-trio-companion-picker" id="detailTrioCompanionPicker" style="display: none;">
                    <div class="companion-title">
                        <i class="fas fa-check-circle"></i>
                        <span>${lang === 'ar' ? 'اختر عطرين إضافيين ليكتمل سلكشن الـ 3 عطور (مطلوب 2):' : 'Choose 2 additional fragrances to complete your trio:'}</span>
                        <span class="companion-counter" id="detailCompanionCounter">0 / 2</span>
                    </div>
                    <div class="companion-tiles-grid">
                        ${(typeof allProducts !== 'undefined' ? allProducts : []).filter(p => p.id !== product.id).map(p => `
                            <button type="button" class="companion-tile" 
                                    data-companion-id="${p.id}" 
                                    data-companion-name="${p.name}">
                                <div class="comp-check"><i class="fas fa-check"></i></div>
                                <img src="${p.image}?v=4.0" alt="${p.name}">
                                <span>${p.name}</span>
                            </button>
                        `).join('')}
                    </div>
                </div>
            </div>

            <!-- Action WhatsApp Direct & Add to Bag -->
            <div class="detail-actions-area">
                <a href="https://wa.me/971561634196?text=${encodeURIComponent(lang === 'ar' ? `مرحباً عجمان لكجري 🦅\nأود طلب عطر: ${product.name}\nالحجم: ${product.size || '100 مل'}\nالسعر: ${product.price}\n(شامل الضريبة والشحن السريع المجاني)\nيرجى تأكيد الطلب لتزويدكم بعنوان التوصيل.` : `Hello AJMAN LUXURY 🦅\nI would like to order: ${product.name}\nSize: ${product.size || '100ml'}\nPrice: ${product.price}\n(Free express delivery included)\nPlease confirm my order.`)}" 
                   target="_blank" class="btn-whatsapp-direct detail-wa-btn">
                    <i class="fab fa-whatsapp"></i>
                    <span>${lang === 'ar' ? 'طلب فوري عبر واتساب مباشرةً' : 'Order Directly via WhatsApp'}</span>
                </a>
                <button type="button" class="btn-add-to-cart detail-add-btn" data-add-to-cart 
                        data-product-id="${product.id}" 
                        data-product-name="${product.name}" 
                        data-product-price="${product.price}" 
                        data-product-image="${product.image}">
                    <i class="fas fa-bag-shopping"></i>
                    <span>${lang === 'ar' ? 'أضف إلى السلة' : 'Add to Bag'}</span>
                </button>
            </div>

            <!-- Fragrance Notes -->
            <div class="detail-notes-section">
                <h3>${lang === 'ar' ? 'الهرم العطري والمكونات' : 'Fragrance Notes'}</h3>
                <div class="notes-grid-3">
                    <div class="note-box">
                        <strong>${lang === 'ar' ? 'الافتتاحية' : 'Top Notes'}</strong>
                        <p>${product.topNotes || 'البرغموت، الزعفران، الورد'}</p>
                    </div>
                    <div class="note-box">
                        <strong>${lang === 'ar' ? 'قلب العطر' : 'Heart Notes'}</strong>
                        <p>${product.heartNotes || 'الياسمين الملكي، أخشاب الأرز'}</p>
                    </div>
                    <div class="note-box">
                        <strong>${lang === 'ar' ? 'القاعدة' : 'Base Notes'}</strong>
                        <p>${product.baseNotes || 'العود الإماراتي، العنبر، المسك'}</p>
                    </div>
                </div>
            </div>

            <div class="detail-story-section">
                <h3>${lang === 'ar' ? 'قصة العطر' : 'The Fragrance Story'}</h3>
                <p class="story-p">${product.story || product.description}</p>
            </div>
        </div>
    </div>
</section>
    `,
    lang: lang,
    isRTL: isRTL,
    currentPath: currentPath,
    t: t
}) %>
