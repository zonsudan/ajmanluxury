<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= isRTL ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= t.siteName %> — <%= lang === 'ar' ? 'الفخامة أو لا شيء | دار عطور نيش إماراتية فاخرة' : 'Greatness or Nothing | Luxury Niche Fragrance House' %>">
    <title><%= t.siteName %> | <%= lang === 'ar' ? 'الفخامة أو لا شيء' : 'Greatness or Nothing' %></title>
    
    <link rel="icon" href="<%= designSettings.faviconPath || '/favicon.png' %>?v=3.8">
    <link rel="shortcut icon" href="<%= designSettings.faviconPath || '/favicon.png' %>?v=3.8">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3.8">
    
    <!-- FontAwesome & Google Arabic Fonts (Tajawal like 3saf) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/style.css?v=4.3">
</head>
<body class="theme-3saf <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'home-page' : 'inner-page' %>">

    <!-- 1. Top Minimal Email Bar (Exact 3saf Top Strip) -->
    <div class="top-support-bar">
        <div class="container-fluid top-bar-inner">
            <div class="support-email">
                <i class="far fa-envelope"></i>
                <a href="mailto:support@ajman-luxury.com">support@ajman-luxury.com</a>
            </div>
            <div class="top-lang-link">
                <a href="<%= currentPath %>?lang=<%= lang === 'ar' ? 'en' : 'ar' %>">
                    <%= lang === 'ar' ? 'English' : 'العربية' %>
                </a>
            </div>
        </div>
    </div>

    <!-- 2. Transparent Floating Header (Tailored Exclusively to the 5 Perfumes) -->
    <header class="site-header-3saf" id="siteHeader">
        <div class="container-fluid header-inner">
            <!-- Right: Brand Logo -->
            <div class="header-right-col">
                <a href="/?lang=<%= lang %>" class="brand-logo-link" aria-label="<%= t.siteName %>">
                    <img src="/images/logo-transparent.png?v=3.9" alt="<%= t.siteName %>" class="brand-logo-img">
                </a>
            </div>

            <!-- Center: Navigation Menu for the 5 Signature Perfumes Only -->
            <!-- Center: Luxury Navigation Menu -->
            <nav class="header-center-nav">
                <ul class="nav-links-list">
                    <li><a href="/?lang=<%= lang %>" class="active"><%= lang === 'ar' ? 'الرئيسية' : 'Home' %></a></li>
                    
                    <!-- Dropdown for the 5 Signature Perfumes -->
                    <li class="has-dropdown">
                        <a href="#featured-collection" class="dropdown-trigger">
                            <span><%= lang === 'ar' ? 'العطور الخاصة' : 'Signature Scents' %></span>
                            <i class="fas fa-chevron-down"></i>
                        </a>
                        <div class="nav-dropdown-menu">
                            <a href="#product-president" class="dropdown-item">
                                <img src="/images/products/president.png?v=4.0" alt="President" class="dropdown-thumb">
                                <div class="dropdown-item-info">
                                    <span class="dropdown-item-name"><%= lang === 'ar' ? 'بريزدنت' : 'President' %></span>
                                    <span class="dropdown-item-sub"><%= lang === 'ar' ? 'عنبري خشبي مهيب' : 'Amber Woods' %></span>
                                </div>
                            </a>
                            <a href="#product-first-lady" class="dropdown-item">
                                <img src="/images/products/first-lady.png?v=4.0" alt="First Lady" class="dropdown-thumb">
                                <div class="dropdown-item-info">
                                    <span class="dropdown-item-name"><%= lang === 'ar' ? 'فيرست ليدي' : 'First Lady' %></span>
                                    <span class="dropdown-item-sub"><%= lang === 'ar' ? 'زهري عنبري أنثوي' : 'Floral Amber' %></span>
                                </div>
                            </a>
                            <a href="#product-chairman" class="dropdown-item">
                                <img src="/images/products/chairman.png?v=4.0" alt="Chairman" class="dropdown-thumb">
                                <div class="dropdown-item-info">
                                    <span class="dropdown-item-name"><%= lang === 'ar' ? 'تشيرمان' : 'Chairman' %></span>
                                    <span class="dropdown-item-sub"><%= lang === 'ar' ? 'أزرق عطري واثق' : 'Aromatic Woods' %></span>
                                </div>
                            </a>
                            <a href="#product-council" class="dropdown-item">
                                <img src="/images/products/council.png?v=4.0" alt="Council" class="dropdown-thumb">
                                <div class="dropdown-item-info">
                                    <span class="dropdown-item-name"><%= lang === 'ar' ? 'كاونسل' : 'Council' %></span>
                                    <span class="dropdown-item-sub"><%= lang === 'ar' ? 'عود مهيب للمجالس' : 'Dignified Oud' %></span>
                                </div>
                            </a>
                            <a href="#product-parliament" class="dropdown-item">
                                <img src="/images/products/parliament.png?v=4.0" alt="Parliament" class="dropdown-thumb">
                                <div class="dropdown-item-info">
                                    <span class="dropdown-item-name"><%= lang === 'ar' ? 'بارليامنت' : 'Parliament' %></span>
                                    <span class="dropdown-item-sub"><%= lang === 'ar' ? 'مسك وأزهار بيضاء' : 'White Florals & Musk' %></span>
                                </div>
                            </a>
                            <div class="dropdown-all-link">
                                <a href="#featured-collection"><%= lang === 'ar' ? 'تصفح العطور كاملة (بالحبة)' : 'Explore All Perfumes' %> <i class="fas fa-arrow-left"></i></a>
                            </div>
                        </div>
                    </li>

                    <li>
                        <a href="#trio-custom-selection" class="nav-pill-link trio-pill">
                            <i class="fas fa-layer-group"></i>
                            <span><%= lang === 'ar' ? 'سلكشن 3 عطور' : 'Trio Selection' %></span>
                        </a>
                    </li>

                    <li>
                        <a href="#royal-5-box" class="nav-pill-link royal-pill">
                            <i class="fas fa-crown"></i>
                            <span><%= lang === 'ar' ? 'البوكس الملكي' : 'Royal 5 Box' %></span>
                        </a>
                    </li>

                    <li>
                        <a href="#nfc-smart-fragrance" class="nav-nfc-link">
                            <i class="fa-solid fa-wifi fa-rotate-90"></i>
                            <span><%= lang === 'ar' ? 'تقنية NFC' : 'Smart NFC' %></span>
                        </a>
                    </li>

                    <li>
                        <a href="#golden-guarantee">
                            <i class="fas fa-shield-halved"></i>
                            <span><%= lang === 'ar' ? 'الضمان الذهبي' : 'Guarantee' %></span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Left: Search, User, and Cart with Red Badge -->
            <div class="header-left-col">
                <button type="button" class="tool-icon-btn" id="searchTriggerBtn" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
                <a href="/admin/login" class="tool-icon-btn" aria-label="Account">
                    <i class="far fa-user"></i>
                </a>
                <button type="button" class="tool-icon-btn cart-btn-wrap" id="cartToggleBtn" aria-label="Cart">
                    <i class="fas fa-bag-shopping"></i>
                    <span class="red-cart-badge" data-cart-count>0</span>
                </button>

                <!-- Mobile Menu Trigger -->
                <button type="button" class="mobile-nav-toggle" id="mobileMenuBtn" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>

        <!-- Search Bar Overlay -->
        <div class="search-drop-bar" id="searchDropBar">
            <div class="container search-bar-inner">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="<%= lang === 'ar' ? 'ابحث عن عطرك المفضل (بريزدنت، فيرست ليدي، تشيرمان، كاونسل، برلمان)...' : 'Search perfumes (President, First Lady, Chairman, Council, Parliament)...' %>">
                <button type="button" class="close-search-btn" id="closeSearchBtn"><i class="fas fa-times"></i></button>
            </div>
        </div>
    </header>

    <!-- Mobile Drawer Navigation -->
    <div class="mobile-drawer-overlay" id="mobileDrawerOverlay">
        <div class="mobile-drawer">
            <div class="drawer-header">
                <img src="/images/logo-wordmark.png" alt="<%= t.siteName %>" class="drawer-logo">
                <button class="close-drawer-btn" id="closeDrawerBtn"><i class="fas fa-times"></i></button>
            </div>
            <ul class="drawer-nav">
                <li><a href="/?lang=<%= lang %>"><i class="fas fa-home"></i> <%= lang === 'ar' ? 'الرئيسية' : 'Home' %></a></li>
                <li><a href="#featured-collection"><i class="fas fa-spray-can"></i> <%= lang === 'ar' ? 'العطور بالحبة (الـ 5 أصناف)' : 'Single Perfumes' %></a></li>
                <li><a href="#trio-custom-selection"><i class="fas fa-layer-group" style="color: #900c3f;"></i> <%= lang === 'ar' ? 'سلكشن 3 عطور (وفّر 500+ د.إ)' : 'Custom Trio Selection' %></a></li>
                <li><a href="#royal-5-box"><i class="fas fa-crown" style="color: #d4af37;"></i> <%= lang === 'ar' ? 'البوكس الملكي الشامل (5 عطور)' : 'Royal 5-Bottle Box' %></a></li>
                <li><a href="#product-president"><i class="fas fa-crown"></i> President — <%= lang === 'ar' ? 'بريزدنت' : 'President' %></a></li>
                <li><a href="#product-first-lady"><i class="fas fa-heart"></i> First Lady — <%= lang === 'ar' ? 'فيرست ليدي' : 'First Lady' %></a></li>
                <li><a href="#product-chairman"><i class="fas fa-compass"></i> Chairman — <%= lang === 'ar' ? 'تشيرمان' : 'Chairman' %></a></li>
                <li><a href="#product-council"><i class="fas fa-tree"></i> Council — <%= lang === 'ar' ? 'كاونسل' : 'Council' %></a></li>
                <li><a href="#product-parliament"><i class="fas fa-gem"></i> Parliament — <%= lang === 'ar' ? 'برلمان' : 'Parliament' %></a></li>
                <li><a href="#nfc-smart-fragrance"><i class="fa-solid fa-wifi fa-rotate-90" style="color: #d4af37;"></i> <%= lang === 'ar' ? 'الفخامة الذكية وتقنية NFC' : 'Smart NFC Experience' %></a></li>
                <li><a href="#golden-guarantee"><i class="fas fa-shield-halved"></i> <%= lang === 'ar' ? 'الضمان الذهبي للتجربة' : 'Golden Guarantee' %></a></li>
                <li><a href="/admin/login"><i class="fas fa-lock"></i> <%= lang === 'ar' ? 'لوحة التحكم' : 'Admin Area' %></a></li>
            </ul>
        </div>
    </div>

    <!-- Main View Content Injection -->
    <main class="main-site-content">
        <%- body %>
    </main>

    <!-- Slide-Out Shopping Cart Drawer -->
    <div class="cart-drawer-overlay" id="cartOverlay">
        <div class="cart-drawer-panel">
            <div class="cart-drawer-header">
                <div class="cart-title">
                    <i class="fas fa-bag-shopping"></i>
                    <span><%= lang === 'ar' ? 'سلة المشتريات' : 'Shopping Cart' %></span>
                    (<span id="cartHeaderCount">0</span>)
                </div>
                <button class="close-cart-btn" id="closeCartBtn"><i class="fas fa-times"></i></button>
            </div>

            <div class="cart-free-shipping-progress">
                <div class="progress-text">
                    <i class="fas fa-truck-fast"></i>
                    <span><%= lang === 'ar' ? 'شحن مجاني لكافة طلبات دول الخليج' : 'Free Express GCC Shipping' %></span>
                </div>
                <div class="progress-bar-wrap">
                    <div class="progress-fill" style="width: 100%;"></div>
                </div>
            </div>

            <div class="cart-drawer-items" id="cartItemsContainer">
                <!-- Dynamically rendered -->
            </div>

            <div class="cart-drawer-footer">
                <div class="subtotal-row">
                    <span><%= lang === 'ar' ? 'المجموع الفرعي:' : 'Subtotal:' %></span>
                    <strong class="subtotal-amount" id="cartDrawerSubtotal">0 د.إ</strong>
                </div>

                <button type="button" class="checkout-submit-btn whatsapp-submit-btn" id="cartWhatsappCheckoutBtn">
                    <i class="fab fa-whatsapp"></i>
                    <span><%= lang === 'ar' ? 'إتمام الطلب عبر واتساب مباشرةً' : 'Complete Order on WhatsApp' %></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Sticky Mobile Bottom Bar -->
    <div class="mobile-bottom-bar">
        <a href="/?lang=<%= lang %>" class="bottom-bar-item active">
            <i class="fas fa-home"></i>
            <span><%= lang === 'ar' ? 'الرئيسية' : 'Home' %></span>
        </a>
        <a href="#featured-collection" class="bottom-bar-item">
            <i class="fas fa-spray-can"></i>
            <span><%= lang === 'ar' ? 'العطور' : 'Shop' %></span>
        </a>
        <button type="button" class="bottom-bar-item" id="mobileBottomCartBtn">
            <div class="cart-icon-rel">
                <i class="fas fa-bag-shopping"></i>
                <span class="cart-badge-dot" data-cart-count>0</span>
            </div>
            <span><%= lang === 'ar' ? 'السلة' : 'Cart' %></span>
        </button>
        <a href="https://wa.me/<%= designSettings.whatsappNumber || '971561634196' %>" target="_blank" rel="noopener" class="bottom-bar-item whatsapp-item">
            <i class="fab fa-whatsapp"></i>
            <span><%= lang === 'ar' ? 'واتساب' : 'WhatsApp' %></span>
        </a>
    </div>

    <!-- Floating Scroll-To-Top Arrow -->
    <button type="button" class="scroll-top-btn" id="scrollTopBtn" aria-label="Scroll to top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <!-- Official 3saf Style Footer -->
    <footer class="site-footer">
        <div class="footer-features-strip">
            <div class="container features-grid">
                <div class="feature-item">
                    <i class="fas fa-truck-fast"></i>
                    <div>
                        <strong><%= lang === 'ar' ? 'شحن سريع ومجاني' : 'Express Free Shipping' %></strong>
                        <p><%= lang === 'ar' ? 'توصيل لباب المنزل في جميع دول الخليج' : 'Fast doorstep delivery' %></p>
                    </div>
                </div>
                <div class="feature-item">
                    <i class="fas fa-shield-halved"></i>
                    <div>
                        <strong><%= lang === 'ar' ? 'الضمان الذهبي' : 'Golden Guarantee' %></strong>
                        <p><%= lang === 'ar' ? 'عينة تجربة مجانية واسترجاع بدون تعقيد' : 'Free trial sample & easy return' %></p>
                    </div>
                </div>
                <div class="feature-item">
                    <i class="fas fa-certificate"></i>
                    <div>
                        <strong><%= lang === 'ar' ? 'عطور أصلية 100%' : '100% Authentic Extrait' %></strong>
                        <p><%= lang === 'ar' ? 'ثبات وفوحان يدوم لأكثر من 48 ساعة' : 'Exceptional 48h longevity' %></p>
                    </div>
                </div>
                <div class="feature-item">
                    <i class="fas fa-lock"></i>
                    <div>
                        <strong><%= lang === 'ar' ? 'دفع إلكتروني آمن' : '100% Secure Checkout' %></strong>
                        <p><%= lang === 'ar' ? 'مدى، Apple Pay، وبطاقات الائتمان المشفرة' : 'Apple Pay, Mada & Encrypted Cards' %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="container footer-main-content">
            <div class="footer-col brand-col">
                <img src="/images/logo-wordmark.png" alt="<%= t.siteName %>" class="footer-brand-logo">
                <p class="brand-motto"><%= lang === 'ar' ? 'عجمان لكجري — الفخامة أو لا شيء. دار عطور إكستريت دي بارفان تترجم نبالة الصقر الإماراتي والنوتات النادرة إلى حضور استثنائي.' : 'AJMAN LUXURY — Greatness or Nothing.' %></p>
            </div>

            <div class="footer-col">
                <h4 class="col-title"><%= lang === 'ar' ? 'العطور الخاصة (الـ 5 أصناف)' : 'Signature Scents' %></h4>
                <ul class="col-links">
                    <li><a href="#product-president">President — <%= lang === 'ar' ? 'بريزدنت' : 'President' %></a></li>
                    <li><a href="#product-first-lady">First Lady — <%= lang === 'ar' ? 'فيرست ليدي' : 'First Lady' %></a></li>
                    <li><a href="#product-chairman">Chairman — <%= lang === 'ar' ? 'تشيرمان' : 'Chairman' %></a></li>
                    <li><a href="#product-council">Council — <%= lang === 'ar' ? 'كاونسل' : 'Council' %></a></li>
                    <li><a href="#product-parliament">Parliament — <%= lang === 'ar' ? 'برلمان' : 'Parliament' %></a></li>
                </ul>
            </div>

            <div class="footer-col compliance-col">
                <h4 class="col-title"><%= lang === 'ar' ? 'الرخص والدفع' : 'Compliance & Pay' %></h4>
                <p class="cr-text"><%= lang === 'ar' ? 'رقم السجل التجاري: 1010729481' : 'CR: 1010729481' %></p>
                <p class="cr-text"><%= lang === 'ar' ? 'الرقم الضريبي: 310592817400003' : 'Tax ID: 310592817400003' %></p>
                
                <div class="payment-badges-grid">
                    <span class="pay-tag mada">مدى</span>
                    <span class="pay-tag apple">Apple Pay</span>
                    <span class="pay-tag visa">VISA</span>
                    <span class="pay-tag mc">Mastercard</span>
                </div>
            </div>
        </div>

        <div class="footer-bottom-copyright">
            <div class="container copy-inner">
                <span><%= lang === 'ar' ? 'جميع الحقوق محفوظة © 2026 عجمان لكجري (AJMAN LUXURY)' : 'All Rights Reserved © 2026 AJMAN LUXURY' %></span>
                <span class="motto-tag"><%= lang === 'ar' ? 'الفخامة أو لا شيء' : 'Greatness or Nothing' %></span>
            </div>
        </div>
    </footer>

    <script src="/js/main.js?v=4.3"></script>
</body>
</html>
